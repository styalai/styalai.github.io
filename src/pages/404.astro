---
/** 404 page. GitHub Pages serves this for any path it cannot find. */
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
import { withBase } from '../lib/urls';
---

<BaseLayout title="Page not found" description="That page does not exist.">
  <div class="wrap">
    <h1 class="intro__title">404</h1>
    <p class="intro__lede">That page does not exist. It may have been renamed, or the link may be wrong.</p>
    <p><a href={withBase('/')}>Back to {SITE.title}</a></p>
  </div>
</BaseLayout>